{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "ZimRobotics",
    "version": "2026.12.0",
    "identifier": "com.zimrobotics.app",
    "build": {
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run tauri:prebuild",
        "devUrl": "http://localhost:8080",
        "frontendDist": "../src/dist"
    },
    "app": {
        "security": {
            "csp": null,
            "capabilities": [
                "default",
                "android",
                "ios"
            ]
        },
        "windows": [
            {
                "title": "ZimRobotics",
                "width": 1024,
                "height": 550,
                "minWidth": 1024,
                "minHeight": 550,
                "resizable": true,
                "fullscreen": false,
                "dragDropEnabled": false
            }
        ]
    },
    "bundle": {
        "active": true,
        "targets": [
            "deb",
            "rpm",
            "appimage",
            "dmg",
            "nsis"
        ],
        "icon": [
            "icons/zimrobotics_icon_128.png",
            "icons/zimrobotics_icon.ico",
            "icons/zimrobotics_icon.icns"
        ],
        "category": "Utility",
        "copyright": "ZimRobotics.",
        "shortDescription": "Configuration and management application for ZimRobotics flight controllers.",
        "longDescription": "Crossplatform configuration and management application for ZimRobotics flight control firmware.",
        "iOS": {
            "minimumSystemVersion": "13.0"
        }
    },
    "plugins": {
        "shell": {
            "open": true
        }
    }
}
